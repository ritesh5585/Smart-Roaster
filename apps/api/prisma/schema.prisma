generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  POD_LEAD
  EMPLOYEE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now())

  @@map("users")
}

enum OperatingRule {
  ALL_365
  EXCEPT_HOLIDAYS
  NO_SUN_HOLIDAYS
}

model Pod {
  id      String     @id @default(uuid())
  name    String     @unique
  leadId  String?    @unique
  lead    Employee?  @relation("PodLead", fields: [leadId], references: [id])
  members Employee[] @relation("PodMembers")

  @@map("pods")
}

model Employee {
  id          String       @id @default(uuid())
  name        String
  email       String?      @unique
  isActive    Boolean      @default(true)
  podId       String?
  pod         Pod?         @relation("PodMembers", fields: [podId], references: [id])
  ledPod      Pod?         @relation("PodLead")
  assignments Assignment[]
  createdAt   DateTime     @default(now())

  @@map("employees")
}

model Process {
  id             String         @id @default(uuid())
  code           String         @unique // CS, ACC, NDR, RET
  name           String
  brandProcesses BrandProcess[]

  @@map("processes")
}

model Brand {
  id             String         @id @default(uuid())
  name           String         @unique
  isActive       Boolean        @default(true)
  brandProcesses BrandProcess[]

  @@map("brands")
}

model BrandProcess {
  id            String        @id @default(uuid())
  brandId       String
  processId     String
  operatingRule OperatingRule @default(EXCEPT_HOLIDAYS)
  minCoverage   Int           @default(1)
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  process       Process       @relation(fields: [processId], references: [id])
  assignments   Assignment[]

  @@unique([brandId, processId])
  @@map("brand_processes")
}

model Assignment {
  id             String       @id @default(uuid())
  employeeId     String
  brandProcessId String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  brandProcess   BrandProcess @relation(fields: [brandProcessId], references: [id], onDelete: Cascade)

  @@unique([employeeId, brandProcessId])
  @@map("assignments")
}
